<Window x:Class="PwHelper.App.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="..." Height="160" Width="360" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <StackPanel Margin="12">
        <TextBlock x:Name="PromptLabel"/>
        <TextBox x:Name="ValueBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
