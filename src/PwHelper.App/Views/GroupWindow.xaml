<Window x:Class="PwHelper.App.Views.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group Mode" Height="550" Width="800"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="200" Background="{StaticResource SurfaceBrush}">
            <ListBox x:Name="GroupList" Margin="8" Height="200"
                     ItemsSource="{Binding Groups}"
                     DisplayMemberPath="Name"
                     SelectedItem="{Binding SelectedGroup}"/>
            <Button x:Name="AddGroupButton" Content="+" Command="{Binding AddGroupCommand}"/>
            <CheckBox x:Name="SyncCheck" Margin="8" IsChecked="{Binding SyncEnabled}"/>
            <TextBlock x:Name="LimitationLabel" Margin="8" TextWrapping="Wrap" FontStyle="Italic" FontSize="11"/>
        </StackPanel>
        <StackPanel Margin="8">
            <TextBlock x:Name="OnlineLabel" FontWeight="Bold" Margin="0,0,0,4"/>
            <ListBox x:Name="OnlineList" Height="150" ItemsSource="{Binding OnlineMembers}" DisplayMemberPath="Role"/>
            <TextBlock x:Name="PresetsLabel" FontWeight="Bold" Margin="0,8,0,4"/>
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Width="250" VerticalAlignment="Center"/>
                            <Button Content="Fire"
                                    Command="{Binding DataContext.FirePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="CancelButton" Command="{Binding CancelAllCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
