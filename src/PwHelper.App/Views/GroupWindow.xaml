<Window x:Class="PwHelper.App.Views.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group Mode" Height="550" Width="800"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="200" Background="{StaticResource SurfaceBrush}">
            <ListBox x:Name="GroupList" Margin="8" Height="200"
                     ItemsSource="{Binding Groups}"
                     DisplayMemberPath="Name"
                     SelectedItem="{Binding SelectedGroup}"/>
            <Button x:Name="AddGroupButton" Content="+" Command="{Binding AddGroupCommand}"/>
            <TextBlock x:Name="FormationsLabel" Margin="8,8,8,4" FontWeight="Bold"/>
            <ComboBox x:Name="FormationBox" Margin="8,0,8,4"
                      ItemsSource="{Binding Formations}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedFormation}"/>
            <StackPanel Orientation="Horizontal" Margin="8,0,8,0">
                <Button x:Name="SaveFormationButton" Command="{Binding SaveFormationCommand}"/>
                <Button x:Name="LoadFormationButton" Command="{Binding LoadFormationCommand}"/>
            </StackPanel>
            <CheckBox x:Name="SyncCheck" Margin="8" IsChecked="{Binding SyncEnabled}"/>
            <TextBlock x:Name="LimitationLabel" Margin="8" TextWrapping="Wrap" FontStyle="Italic" FontSize="11"/>
        </StackPanel>
        <StackPanel Margin="8">
            <TextBlock x:Name="OnlineLabel" FontWeight="Bold" Margin="0,0,0,4"/>
            <ListBox x:Name="OnlineList" Height="150" ItemsSource="{Binding OnlineMembers}" DisplayMemberPath="Role"/>
            <TextBlock x:Name="MembersLabel" FontWeight="Bold" Margin="0,8,0,4"/>
            <ListBox x:Name="MembersList" Height="110" ItemsSource="{Binding Members}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding DisplayName}" Width="220" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StatusText}" Width="80" VerticalAlignment="Center"/>
                            <Button Content="{Binding DataContext.RemoveText, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <ComboBox x:Name="AddMemberBox" Width="260" Margin="0,0,8,0"
                          ItemsSource="{Binding AvailableAccounts}"
                          DisplayMemberPath="DisplayName"
                          SelectedItem="{Binding SelectedAccountToAdd}"/>
                <Button x:Name="AddMemberButton" Command="{Binding AddMemberCommand}"/>
            </StackPanel>
            <TextBlock x:Name="PresetsLabel" FontWeight="Bold" Margin="0,8,0,4"/>
            <Button x:Name="NewPresetButton" Command="{Binding AddPresetCommand}" HorizontalAlignment="Left"/>
            <ItemsControl ItemsSource="{Binding Presets}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Width="250" VerticalAlignment="Center"/>
                            <Button Content="Fire"
                                    Command="{Binding DataContext.FirePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="{Binding DataContext.EditText, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Command="{Binding DataContext.EditPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                            <Button Content="{Binding DataContext.DuplicatePresetText, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Command="{Binding DataContext.DuplicatePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button x:Name="CancelButton" Command="{Binding CancelAllCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</Window>
