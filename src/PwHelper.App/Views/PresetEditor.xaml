<Window x:Class="PwHelper.App.Views.PresetEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preset" Height="450" Width="700" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <DockPanel Margin="12">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Save" Click="OnSave"/>
        </StackPanel>
        <ListBox x:Name="ActionList">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding AccountName}" Width="150" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Summary}" Width="220" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DelayBeforeMs, StringFormat='delay {0}ms'}" VerticalAlignment="Center"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
