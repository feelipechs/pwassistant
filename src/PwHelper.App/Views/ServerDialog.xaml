<Window x:Class="PwHelper.App.Views.ServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server" Height="220" Width="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <StackPanel Margin="12">
        <TextBlock x:Name="NameLabel"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock x:Name="PathLabel"/>
        <DockPanel>
            <Button x:Name="BrowseButton" Content="..." DockPanel.Dock="Right" Click="OnBrowse"/>
            <TextBox x:Name="PathBox"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
