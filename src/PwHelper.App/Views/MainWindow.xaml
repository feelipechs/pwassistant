<Window x:Class="PwHelper.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PW Launcher" Height="600" Width="900"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="220" Background="{StaticResource SurfaceBrush}">
            <TextBlock x:Name="ServersLabel" Margin="8,8,8,4" FontWeight="Bold"/>
            <ListBox x:Name="ServerList" Margin="8,0,8,4" Height="300"
                     DisplayMemberPath="Name"
                     SelectedItem="{Binding SelectedServer}"/>
            <Button x:Name="AddServerButton" Content="+" Command="{Binding AddServerCommand}"/>
            <Button x:Name="GroupModeButton" Content="Group" Command="{Binding OpenGroupModeCommand}"/>
            <Button x:Name="RefreshButton" Content="Refresh" Command="{Binding RefreshStatusCommand}"/>
        </StackPanel>
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="8">
                <Button x:Name="AddAccountButton" Content="+ Account" Command="{Binding AddAccountCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ItemsControl x:Name="AccountCards" Margin="8" ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="8">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel Width="250">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding StatusText}"/>
                                </StackPanel>
                                <Button Content="Play"
                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>
</Window>
