<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             x:Class="PwAssistant.Avalonia.App"
             RequestedThemeVariant="Dark">
  <Application.Styles>
    <semi:SemiTheme />
    <semi:UrsaSemiTheme />
    <StyleInclude Source="avares://PwAssistant.Avalonia/Styles/Shadcn.axaml" />
  </Application.Styles>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://PwAssistant.Avalonia/Themes/ShadcnTokens.axaml" />
      </ResourceDictionary.MergedDictionaries>

      <!-- Type scale ported from PwAssistant.App Themes/Typography.xaml.
           Single typeface for the whole app (Cascadia Code, Consolas
           fallback); icon glyphs keep using IconFont explicitly. -->
      <FontFamily x:Key="Font.Family">Cascadia Code, Consolas</FontFamily>
      <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

      <x:Double x:Key="Font.Size.Xs">9</x:Double>
      <x:Double x:Key="Font.Size.Sm">12</x:Double>
      <x:Double x:Key="Font.Size.Md">14</x:Double>
      <x:Double x:Key="Font.Size.Lg">16</x:Double>
      <x:Double x:Key="Font.Size.Xl">20</x:Double>
      <x:Double x:Key="Font.Size.2Xl">24</x:Double>

      <FontWeight x:Key="Font.Weight.Regular">Regular</FontWeight>
      <FontWeight x:Key="Font.Weight.Medium">Medium</FontWeight>
      <FontWeight x:Key="Font.Weight.SemiBold">SemiBold</FontWeight>

      <x:Double x:Key="Size.Control">20</x:Double>
    </ResourceDictionary>
  </Application.Resources>
</Application>
