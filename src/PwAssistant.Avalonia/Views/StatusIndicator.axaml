<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PwAssistant.Avalonia.Views.StatusIndicator">
  <StackPanel Orientation="Horizontal">
    <Ellipse x:Name="Dot" Width="8" Height="8" Margin="0,0,8,0" />
    <TextBlock x:Name="LabelText" VerticalAlignment="Center"
               FontFamily="{StaticResource Font.Family}"
               FontSize="{StaticResource Font.Size.Sm}" />
  </StackPanel>
</UserControl>
