<Window x:Class="PwAssistant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PW Assistant" Height="600" Width="900"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <DockPanel>
        <StackPanel DockPanel.Dock="Left" Width="220" Background="{StaticResource SurfaceBrush}">
            <TextBlock x:Name="ServersLabel" Margin="8,8,8,4" FontWeight="Bold"/>
            <ListBox x:Name="ServerList" Margin="8,0,8,4" Height="300"
                     ItemsSource="{Binding Servers}"
                     DisplayMemberPath="Name"
                     SelectedItem="{Binding SelectedServer}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <Button x:Name="AddServerButton" Content="+" Command="{Binding AddServerCommand}"/>
            <Button x:Name="GroupModeButton" Content="Group" Command="{Binding OpenGroupModeCommand}"/>
            <Button x:Name="RefreshButton" Content="Refresh" Command="{Binding RefreshStatusCommand}"/>
        </StackPanel>
        <StackPanel>
            <TextBlock x:Name="AccountsHeaderLabel" Margin="8,8,8,0" FontWeight="Bold"
                       Text="{Binding AccountsHeader}"/>
            <StackPanel Orientation="Horizontal" Margin="8">
                <Button x:Name="AddAccountButton" Content="+ Account" Command="{Binding AddAccountCommand}"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="12,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <ItemsControl x:Name="AccountCards" Margin="8" ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border BorderBrush="Gray" BorderThickness="1" CornerRadius="4" Margin="0,0,0,8" Padding="8">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Image x:Name="ClassBadge" Width="24" Height="24" Margin="0,0,8,0"
                                           Source="{Binding ClassImagePath}"
                                           ToolTip="{Binding ClassBadgeText}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClassImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <StackPanel Width="220">
                                        <TextBlock Text="{Binding DisplayName}" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding StatusText}"/>
                                    </StackPanel>
                                <Button Content="{Binding PlayText}"
                                        Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                                    <Button Content="{Binding DataContext.EditText, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                    <TextBlock Text="{Binding Model.Login}" Width="150" VerticalAlignment="Center"/>
                                    <Button Content="{Binding DataContext.CopyText, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding DataContext.CopyLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Text="•••" Width="60" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    <Button Content="{Binding DataContext.CopyText, RelativeSource={RelativeSource AncestorType=Window}}"
                                            Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </DockPanel>
</Window>
