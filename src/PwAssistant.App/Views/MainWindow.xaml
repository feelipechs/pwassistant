<Window x:Class="PwAssistant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PwAssistant.App.Views"
        Title="PW Assistant" Height="660" Width="1020" MinHeight="480" MinWidth="800"
        UseLayoutRounding="True"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="{StaticResource Font.Family}"
        Style="{StaticResource ThemedWindow}">
    <DockPanel>
        <views:TitleBar DockPanel.Dock="Top"/>
        <!-- Sidebar: servers -->
        <Border DockPanel.Dock="Left" Width="264" Background="{DynamicResource Brush.Card}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0" Padding="12">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="0,1,0,0" Padding="0,8,0,0" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="RefreshButton" Content="&#xE72C;" Command="{Binding RefreshStatusCommand}"
                                Style="{StaticResource IconButton}"/>
                        <Button x:Name="SettingsButton" Content="&#xE713;" Click="OnOpenSettings"
                                Style="{StaticResource IconButton}"/>
                    </StackPanel>
                </Border>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Button x:Name="AddServerButton" Content="&#xE710;" Command="{Binding AddServerCommand}"
                            DockPanel.Dock="Right" Style="{StaticResource IconButton}"/>
                    <Border Width="8" Height="28" CornerRadius="4" Margin="0,0,8,0"
                            Background="{DynamicResource Brush.Primary}"/>
                    <TextBlock x:Name="ServersLabel" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.Md}"
                               Foreground="{DynamicResource Brush.Foreground}" VerticalAlignment="Center"/>
                </DockPanel>
                <ListBox x:Name="ServerList"
                         ItemsSource="{Binding Servers}"
                         SelectedItem="{Binding SelectedServer}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.Sm}"
                                               Foreground="{DynamicResource Brush.Foreground}"
                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <views:StatusIndicator Kind="{Binding DisplayStatus}" Label="{Binding StatsText}"/>
                                </StackPanel>
                                <StackPanel x:Name="ServerActions" Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Visibility="Collapsed">
                                    <Button Content="&#xE70F;"
                                            Command="{Binding DataContext.EditServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                    <Button Content="&#xE74D;"
                                            Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                </StackPanel>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="ServerActions" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="ServerActions" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>
        <!-- Main area -->
        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock x:Name="AccountsHeaderLabel" FontSize="{StaticResource Font.Size.Lg}" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.Foreground}"
                           Text="{Binding AccountsHeader}" VerticalAlignment="Center"/>
                <Button x:Name="GroupModeButton" Content="Group" Command="{Binding OpenGroupModeCommand}"
                        DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"
                           DockPanel.Dock="Right" Margin="0,0,12,0"/>
            </DockPanel>
            <!-- Tab strip cluster ... account add pinned right -->
            <DockPanel Grid.Row="1" Margin="0,0,0,8">
                <Button x:Name="AddAccountButton" Content="&#xE710;" Command="{Binding AddAccountCommand}"
                        DockPanel.Dock="Right" Style="{StaticResource PrimaryIconButton}"/>
                <Border Width="1" Margin="8,2" Background="{DynamicResource Brush.Border}"
                        DockPanel.Dock="Right"/>
                <StackPanel Orientation="Horizontal">
                <ItemsControl x:Name="TabStrip" ItemsSource="{Binding TabItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton Content="{Binding Title}" GroupName="AccountTabs"
                                         Style="{StaticResource TabToggle}"
                                         IsChecked="{Binding IsSelected, Mode=OneWay}"
                                         Command="{Binding DataContext.SelectTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                         CommandParameter="{Binding}"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Name="AddTabButton" Content="&#xE710;" Command="{Binding AddTabCommand}"
                        Style="{StaticResource IconButton}"/>
                <StackPanel Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsTabSelected}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <Border Width="1" Margin="4,4" Background="{DynamicResource Brush.Border}"/>
                    <Button x:Name="RenameTabButton" Content="&#xE70F;"
                            Command="{Binding RenameTabCommand}" CommandParameter="{Binding SelectedTab}"
                            Style="{StaticResource IconButton}"/>
                    <Button x:Name="DeleteTabButton" Content="&#xE74D;"
                            Command="{Binding DeleteTabCommand}" CommandParameter="{Binding SelectedTab}"
                            Style="{StaticResource IconButton}"/>
                </StackPanel>
                </StackPanel>
            </DockPanel>
            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AccountCards" ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource SquareCard}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="&#xE711;"
                                                Command="{Binding DataContext.RemoveFromTabCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Width="24" Height="24" FontSize="12">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding DataContext.IsTabSelected, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="&#xE70F;"
                                                Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                        <Button Content="&#xE74D;"
                                                Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                    </StackPanel>
                                    <Image x:Name="ClassBadge" Width="56" Height="56" Margin="0,2,0,6"
                                           HorizontalAlignment="Center"
                                           Source="{Binding ClassImagePath}"
                                           ToolTip="{Binding ClassBadgeText}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClassImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.Md}"
                                               Foreground="{DynamicResource Brush.Foreground}"
                                               HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}"/>
                                    <views:StatusIndicator Kind="{Binding DisplayStatus}" Label="{Binding StatusText}"
                                                           HorizontalAlignment="Center" Margin="0,2,0,8"/>
                                    <Button x:Name="PlayButton"
                                            FontFamily="{StaticResource IconFont}" FontSize="{StaticResource Font.Size.Lg}"
                                            ToolTip="{Binding PlayText}"
                                            Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButton}"
                                            HorizontalAlignment="Stretch" MinHeight="{StaticResource Size.Control}">
                                        <TextBlock x:Name="PlayGlyphText" Text="{Binding PlayGlyph}"
                                                   RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform/>
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Button>
                                    <Border Height="1" Margin="0,8" Background="{DynamicResource Brush.Border}"/>
                                    <Border Style="{StaticResource InputBox}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="&#xE8C8;"
                                                        Command="{Binding DataContext.CopyLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding Model.Login}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.MutedForeground}" FontSize="{StaticResource Font.Size.Sm}"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Model.Login}"/>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource InputBox}">
                                        <DockPanel>
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                                <Button Content="&#xE7B3;"
                                                        ToolTip="{Binding PasswordToggleHint}"
                                                        Command="{Binding DataContext.TogglePasswordVisibilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                                <Button Content="&#xE8C8;"
                                                        Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding PasswordDisplay}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.MutedForeground}" FontSize="{StaticResource Font.Size.Sm}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsLaunching}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="LaunchSpin">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="PlayGlyphText"
                                                                 Storyboard.TargetProperty="(TextBlock.RenderTransform).(RotateTransform.Angle)"
                                                                 From="0" To="360" Duration="0:0:1"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="LaunchSpin"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
