<Window x:Class="PwAssistant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PW Assistant" Height="640" Width="960" MinHeight="480" MinWidth="760"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <DockPanel>
        <!-- Sidebar -->
        <Border DockPanel.Dock="Left" Width="248" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                    <Border Width="8" Height="28" CornerRadius="4" Margin="0,0,8,0"
                            Background="{StaticResource AccentBrush}"/>
                    <StackPanel>
                        <TextBlock Text="PW ASSISTANT" FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock x:Name="ServersLabel" FontSize="11"
                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ListBox x:Name="ServerList" Margin="0,8,0,4" Height="300"
                         ItemsSource="{Binding Servers}"
                         DisplayMemberPath="Name"
                         SelectedItem="{Binding SelectedServer}"/>
                <Button x:Name="AddServerButton" Content="+  Servidor" Command="{Binding AddServerCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="0,4,0,0"/>
                <Button x:Name="GroupModeButton" Content="Modo Grupo" Command="{Binding OpenGroupModeCommand}"
                        Margin="0,4,0,0"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="SettingsButton" Content="Config" Click="OnOpenSettings"
                            Style="{StaticResource GhostButton}" Width="110"/>
                    <Button x:Name="RefreshButton" Content="Atualizar" Command="{Binding RefreshStatusCommand}"
                            Style="{StaticResource GhostButton}" Width="110"/>
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Main area -->
        <StackPanel Margin="16,12,16,12">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock x:Name="AccountsHeaderLabel" FontSize="16" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Text="{Binding AccountsHeader}" VerticalAlignment="Center"/>
                <Button x:Name="AddAccountButton" Content="+ Conta" Command="{Binding AddAccountCommand}"
                        Style="{StaticResource PrimaryButton}" Margin="16,0,0,0"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" Margin="16,0,0,0"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AccountCards" ItemsSource="{Binding Accounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Image x:Name="ClassBadge" Width="32" Height="32" Margin="0,0,12,0"
                                               Source="{Binding ClassImagePath}"
                                               ToolTip="{Binding ClassBadgeText}">
                                            <Image.Style>
                                                <Style TargetType="Image">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ClassImagePath}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Image.Style>
                                        </Image>
                                        <StackPanel Width="240">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="13"
                                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="11"
                                                       Foreground="{StaticResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <Button Content="{Binding PlayText}"
                                                Command="{Binding DataContext.PlayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PrimaryButton}" MinWidth="80"/>
                                        <Button Content="{Binding DataContext.EditText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.EditAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}"/>
                                        <Button Content="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.DeleteAccountCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}"/>
                                    </StackPanel>
                                    <Border Height="1" Margin="0,8" Background="{StaticResource BorderBrush}"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Model.Login}" Width="170" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                        <Button Content="{Binding DataContext.CopyText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.CopyLoginCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}"/>
                                        <TextBlock Text="{Binding PasswordDisplay}" MinWidth="60" MaxWidth="150"
                                                   VerticalAlignment="Center" Margin="12,0,0,0"
                                                   Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <Button Content="{Binding PasswordToggleText}"
                                                Command="{Binding DataContext.TogglePasswordVisibilityCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}"/>
                                        <Button Content="{Binding DataContext.CopyText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.CopyPasswordCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource GhostButton}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </StackPanel>
    </DockPanel>
</Window>
