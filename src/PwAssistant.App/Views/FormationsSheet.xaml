<UserControl x:Class="PwAssistant.App.Views.FormationsSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:PwAssistant.App.Resources"
             Visibility="Collapsed">
    <Grid x:Name="Dimmer" Background="#80000000"
          PreviewMouseLeftButtonDown="OnDimmerDown" PreviewKeyDown="OnSheetKeyDown" Focusable="True">
        <Border Width="380" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="FormationsLabel" Style="{StaticResource SectionTitle}"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="320" Margin="0,8,0,0">
                    <ItemsControl ItemsSource="{Binding Formations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                    <StackPanel>
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                            <Button Content="&#xE73E;" Click="OnLoadFormationClick"
                                                    ToolTip="{x:Static res:Strings.LoadFormation}"
                                                    Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                            <Button Content="&#xE70F;" Click="OnRenameFormationClick"
                                                    ToolTip="{x:Static res:Strings.Rename}"
                                                    Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                            <Button Content="&#xE74D;" Click="OnDeleteFormationClick"
                                                    ToolTip="{x:Static res:Strings.Delete}"
                                                    Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                                    Background="Transparent" Cursor="Hand"
                                                    PreviewMouseLeftButtonDown="OnExpandFormationDown">
                                            <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.Foreground}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock x:Name="ExpandGlyph" Text="&#xE76C;" VerticalAlignment="Center"
                                                       FontFamily="{StaticResource IconFont}" FontSize="12" Margin="6,0,0,0"
                                                       Foreground="{DynamicResource Brush.MutedForeground}"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <ItemsControl x:Name="MemberNames" Visibility="Collapsed" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" FontSize="{StaticResource Font.Size.Sm}"
                                                           Foreground="{DynamicResource Brush.MutedForeground}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
