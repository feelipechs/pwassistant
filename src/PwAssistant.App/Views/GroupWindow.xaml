<Window x:Class="PwAssistant.App.Views.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group Mode" Height="600" Width="860"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <DockPanel>
        <Border DockPanel.Dock="Left" Width="230" Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="12">
            <StackPanel>
                <TextBlock Text="GRUPOS" Style="{StaticResource SectionTitle}"/>
                <ListBox x:Name="GroupList" Height="180"
                         ItemsSource="{Binding Groups}"
                         DisplayMemberPath="Name"
                         SelectedItem="{Binding SelectedGroup}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="AddGroupButton" Content="+ Novo" Command="{Binding AddGroupCommand}"
                            Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="MiniModeButton" Command="{Binding OpenMiniModeCommand}"
                            Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <TextBlock x:Name="FormationsLabel" Style="{StaticResource SectionTitle}" Margin="0,12,0,4"/>
                <ComboBox x:Name="FormationBox"
                          ItemsSource="{Binding Formations}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedFormation}"/>
                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Button x:Name="SaveFormationButton" Command="{Binding SaveFormationCommand}"
                            Style="{StaticResource GhostButton}"/>
                    <Button x:Name="LoadFormationButton" Command="{Binding LoadFormationCommand}"
                            Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <TextBlock x:Name="LimitationLabel" Style="{StaticResource MutedText}" Margin="0,12,0,0"/>
            </StackPanel>
        </Border>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16,12,16,12">
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock x:Name="OnlineLabel" Style="{StaticResource SectionTitle}"/>
                        <ListBox x:Name="OnlineList" Height="130" ItemsSource="{Binding OnlineMembers}" DisplayMemberPath="Role"/>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock x:Name="MembersLabel" Style="{StaticResource SectionTitle}"/>
                        <ListBox x:Name="MembersList" Height="110" ItemsSource="{Binding Members}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayName}" Width="220" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding StatusText}" Width="80" VerticalAlignment="Center"
                                                   Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <Button Content="{Binding DataContext.RemoveText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource DangerButton}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <ComboBox x:Name="AddMemberBox" Width="260" Margin="0,0,8,0"
                                      ItemsSource="{Binding AvailableAccounts}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedItem="{Binding SelectedAccountToAdd}"/>
                            <Button x:Name="AddMemberButton" Command="{Binding AddMemberCommand}"
                                    Style="{StaticResource PrimaryButton}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock x:Name="PresetsLabel" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                            <Button x:Name="NewPresetButton" Command="{Binding AddPresetCommand}"
                                    Style="{StaticResource PrimaryButton}" Margin="12,0,0,0"/>
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding Presets}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Width="240" VerticalAlignment="Center"
                                                       FontWeight="SemiBold"/>
                                            <Button Content="{Binding DataContext.EditText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.EditPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostButton}"/>
                                            <Button Content="{Binding DataContext.DuplicatePresetText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.DuplicatePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostButton}"/>
                                            <Button Content="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource DangerButton}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
