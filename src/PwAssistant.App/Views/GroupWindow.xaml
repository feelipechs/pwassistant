<Window x:Class="PwAssistant.App.Views.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PwAssistant.Core.Models;assembly=PwAssistant.Core"
        xmlns:res="clr-namespace:PwAssistant.App.Resources"
        xmlns:vm="clr-namespace:PwAssistant.App.ViewModels"
        xmlns:views="clr-namespace:PwAssistant.App.Views"
        Title="Group Mode" Height="640" Width="980"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="{StaticResource Font.Family}"
        Style="{StaticResource ThemedWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <views:TitleBar/>
    <DockPanel x:Name="RootDock" Grid.Row="1" Margin="16,12,16,12">
        <TextBlock Text="{Binding StatusMessage}" DockPanel.Dock="Bottom" Style="{StaticResource StatusText}"
                   Margin="0,8,0,0" TextWrapping="Wrap"/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock x:Name="TitleLabel" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Foreground}" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Pool: ungrouped characters, drag source; the whole column
                 is the "ungrouped" drop target (AllowDrop lives here, not
                 only on the items list, so empty space works too). -->
            <Border x:Name="PoolBorder" Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0"
                    AllowDrop="True" DragOver="OnPoolDragOver" Drop="OnPoolDrop">
                <DockPanel>
                    <TextBlock x:Name="PoolLabel" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="{x:Static res:Strings.DragHint}" TextWrapping="Wrap"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PoolList" ItemsSource="{Binding Pool}"
                                      PreviewMouseLeftButtonDown="OnPoolPreviewMouseDown"
                                      PreviewMouseMove="OnPoolPreviewMouseMove">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MiniCard}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="16" Height="16" Margin="0,0,8,0"
                                                   Source="{Binding ClassImagePath}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ClassImagePath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding CharacterName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- Group cards + in-flow new-group slot -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                          AllowDrop="True" DragOver="OnOuterDragOver">
                <ItemsControl ItemsSource="{Binding GroupCardsView}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.Resources>
                        <DataTemplate DataType="{x:Type vm:GroupCard}">
                                <Border x:Name="CardBorder" Style="{StaticResource CardBorder}" Width="300" Height="360" Margin="0,0,10,10"
                                        AllowDrop="True" Drop="OnCardDrop" DragOver="OnCardDragOver">
                                <DockPanel>
                                    <DockPanel DockPanel.Dock="Top">
                                        <Button x:Name="CardMenuButton" DockPanel.Dock="Right" Width="28" Height="28"
                                                FontFamily="{StaticResource IconFont}" FontSize="14"
                                                Content="&#xE712;" Click="OnCardMenuToggle"
                                                Style="{StaticResource IconButton}"/>
                                        <Button DockPanel.Dock="Right" Width="28" Height="28"
                                                FontFamily="{StaticResource IconFont}" FontSize="12"
                                                Content="&#xE740;"
                                                ToolTip="{Binding DataContext.MinimizeText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Command="{Binding DataContext.MinimizeCardToMiniCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource IconButton}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Group.Name}" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.Md}"
                                                           Foreground="{DynamicResource Brush.Foreground}" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="{StaticResource Font.Size.Sm}"
                                                           Foreground="{DynamicResource Brush.MutedForeground}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                    </DockPanel>
                                        <Popup IsOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=CardMenuButton}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                               Closed="OnCardMenuClosed">
                                            <Border Background="{DynamicResource Brush.Card}"
                                                    BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1"
                                                CornerRadius="8" Padding="8" MinWidth="220">
                                            <StackPanel>
                                                <Button Content="{Binding DataContext.RenameText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
                                                <Button Content="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
                                                <Button Content="{Binding DataContext.PresetsText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.OpenPresetsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
                                                <Border Height="1" Margin="0,6" Background="{DynamicResource Brush.Border}"/>
                                                <Button Content="{Binding DataContext.SaveFormationText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.SaveFormationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
                                                <Button Content="{Binding DataContext.LoadFormationText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        Command="{Binding DataContext.OpenFormationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,6,0,0">
                                        <ItemsControl ItemsSource="{Binding Members}"
                                                        AllowDrop="True"
                                                        PreviewMouseLeftButtonDown="OnMemberPreviewMouseDown"
                                                        PreviewMouseMove="OnMemberPreviewMouseMove"
                                                        DragOver="OnMembersDragOver"
                                                        Drop="OnMembersDrop">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MiniCard}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Width="16" Height="16" Margin="0,0,8,0"
                                                                   Source="{Binding ClassImagePath}">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ClassImagePath}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <TextBlock Text="{Binding CharacterName}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </DockPanel>
                            </Border>
                                <DataTemplate.Triggers>
                                    <!-- Brush only: changing BorderThickness
                                         reflows the whole card on every
                                         toggle (visible flicker). -->
                                    <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{DynamicResource Brush.Primary}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type vm:NewGroupSlot}">
                            <Grid Width="300" Height="360" Margin="0,0,10,10">
                                <Rectangle Stroke="{DynamicResource Brush.Border}" StrokeThickness="1"
                                           StrokeDashArray="6 4" RadiusX="8" RadiusY="8"/>
                                <Button Content="&#xE710;" ToolTip="{x:Static res:Strings.NewGroup}"
                                        Command="{Binding DataContext.AddGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        Style="{StaticResource IconButton}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.Resources>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
    <!-- Drag ghost host: Canvas sits above content; IsHitTestVisible=False
         so drops still reach the real targets underneath. -->
    <Canvas x:Name="GhostLayer" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>
