<Window x:Class="PwAssistant.App.Views.GroupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PwAssistant.Core.Models;assembly=PwAssistant.Core"
        xmlns:res="clr-namespace:PwAssistant.App.Resources"
        Title="Group Mode" Height="640" Width="980"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <DockPanel Margin="16,12,16,12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="MiniModeButton" Command="{Binding OpenMiniModeCommand}"
                    DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}"
                    MinWidth="110" VerticalAlignment="Center"/>
            <Button x:Name="AddGroupButton" Content="&#xE710;" Command="{Binding AddGroupCommand}"
                    DockPanel.Dock="Right" Style="{StaticResource IconButton}" Margin="8,0,0,0"
                    VerticalAlignment="Center"/>
            <TextBlock x:Name="TitleLabel" FontSize="16" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <!-- Pool: ungrouped characters, drag source -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,6,0">
                <DockPanel>
                    <TextBlock x:Name="PoolLabel" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}"/>
                    <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource MutedText}" Margin="0,6,0,0"
                               Text="{x:Static res:Strings.DragHint}" TextWrapping="Wrap"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PoolList" ItemsSource="{Binding Pool}"
                                      AllowDrop="True" Drop="OnPoolDrop" DragOver="OnPoolDragOver"
                                      PreviewMouseLeftButtonDown="OnPoolPreviewMouseDown"
                                      PreviewMouseMove="OnPoolPreviewMouseMove">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource MiniCard}">
                                        <StackPanel Orientation="Horizontal">
                                            <Image Width="24" Height="24" Margin="0,0,8,0"
                                                   Source="{Binding ClassImagePath}">
                                                <Image.Style>
                                                    <Style TargetType="Image">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding ClassImagePath}" Value="{x:Null}">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Image.Style>
                                            </Image>
                                            <TextBlock Text="{Binding CharacterName}" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
            <!-- Group cards -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <DockPanel>
                    <ItemsControl ItemsSource="{Binding GroupCards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="CardBorder" Style="{StaticResource CardBorder}" Width="300" Margin="0,0,10,10"
                                        AllowDrop="True" Drop="OnCardDrop" DragEnter="OnCardDragEnter" DragOver="OnCardDragOver" DragLeave="OnCardDragLeave"
                                        MouseLeftButtonUp="OnCardActivate">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button x:Name="CardMenuButton" DockPanel.Dock="Right" Width="28" Height="28"
                                                    FontFamily="{StaticResource IconFont}" FontSize="14"
                                                    Content="&#xE712;" Click="OnCardMenuToggle"
                                                    Style="{StaticResource IconButton}"/>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Group.Name}" FontWeight="SemiBold" FontSize="13"
                                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding Subtitle}" FontSize="11"
                                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DockPanel>
                                        <Popup IsOpen="{Binding IsMenuOpen, Mode=TwoWay}"
                                               PlacementTarget="{Binding ElementName=CardMenuButton}"
                                               Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                                               Closed="OnCardMenuClosed">
                                            <Border Background="{StaticResource SurfaceBrush}"
                                                    BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                                    CornerRadius="8" Padding="8" MinWidth="220">
                                                <StackPanel>
                                                    <Button Content="{Binding DataContext.RenameText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Command="{Binding DataContext.RenameGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
                                                    <Button Content="{Binding DataContext.DeleteText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Command="{Binding DataContext.DeleteGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
                                                    <Button Content="{Binding DataContext.PresetsText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Command="{Binding DataContext.OpenPresetsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
                                                    <Border Height="1" Margin="0,6" Background="{StaticResource BorderBrush}"/>
                                                    <Button Content="{Binding DataContext.SaveFormationText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Command="{Binding DataContext.SaveFormationCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
                                                    <Button Content="{Binding DataContext.LoadFormationText, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Command="{Binding DataContext.OpenFormationsCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}" HorizontalAlignment="Stretch"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                        <ItemsControl ItemsSource="{Binding Members}" Margin="0,6,0,0"
                                                        PreviewMouseLeftButtonDown="OnMemberPreviewMouseDown"
                                                        PreviewMouseMove="OnMemberPreviewMouseMove"
                                                        DragOver="OnMembersDragOver"
                                                        DragLeave="OnMembersDragLeave"
                                                        Drop="OnMembersDrop">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource MiniCard}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Image Width="24" Height="24" Margin="0,0,8,0"
                                                                   Source="{Binding ClassImagePath}">
                                                                <Image.Style>
                                                                    <Style TargetType="Image">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ClassImagePath}" Value="{x:Null}">
                                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Image.Style>
                                                            </Image>
                                                            <TextBlock Text="{Binding CharacterName}" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="2"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding DataContext.IsDragging, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                                        <Setter TargetName="CardBorder" Property="BorderBrush" Value="{StaticResource AccentHoverBrush}"/>
                                        <Setter TargetName="CardBorder" Property="BorderThickness" Value="3"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
