<UserControl x:Class="PwAssistant.App.Views.AccountSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="Dimmer" Background="#80000000"
          PreviewMouseLeftButtonDown="OnDimmerDown" PreviewKeyDown="OnSheetKeyDown" Focusable="True">
        <Border Width="380" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="480">
            <StackPanel>
                <TextBlock x:Name="LoginLabel" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,0,0,2"/>
                <TextBox x:Name="LoginBox"/>
                <TextBlock x:Name="PasswordLabel" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,8,0,2"/>
                <PasswordBox x:Name="PasswordBox"/>
                <TextBlock x:Name="RoleLabel" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,8,0,2"/>
                <TextBox x:Name="RoleBox"/>
                <TextBlock x:Name="NicknameLabel" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,8,0,2"/>
                <TextBox x:Name="NicknameBox"/>
                <CheckBox x:Name="SameAsRoleCheck" Margin="0,8,0,0"/>
                <TextBlock x:Name="ClassLabel" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,8,0,2"/>
                <ComboBox x:Name="ClassBox" DisplayMemberPath="Display"/>
                <TextBlock x:Name="TagLabel" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,8,0,2"/>
                <ComboBox x:Name="TagBox"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="CancelButton" Click="OnCancel" Style="{StaticResource GhostButton}"/>
                    <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
                </StackPanel>
            </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
