<Window x:Class="PwAssistant.App.Views.PresetEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PwAssistant.Core.Models;assembly=PwAssistant.Core"
        xmlns:res="clr-namespace:PwAssistant.App.Resources"
        Title="Preset" Height="480" Width="900" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <DockPanel Margin="16,12,16,12">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="{x:Static res:Strings.CancelDialog}" Click="OnCancel" Style="{StaticResource GhostButton}"/>
            <Button Content="{x:Static res:Strings.Save}" Click="OnSave" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
        </StackPanel>
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorder}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="NameCaption" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBox x:Name="NameBox" Width="180" Margin="0,0,16,0"/>
                    <TextBlock x:Name="ModeCaption" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <ComboBox x:Name="ModeBox" Width="130" Margin="0,0,16,0"/>
                    <TextBlock x:Name="HotkeyCaption" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                    <TextBlock x:Name="HotkeyValueLabel" Width="140" VerticalAlignment="Center" Margin="0,0,8,0"
                               Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold"/>
                    <Button x:Name="RecordHotkeyButton" Click="OnRecordHotkey" Style="{StaticResource GhostButton}"/>
                </StackPanel>
                <TextBlock x:Name="HotkeyHintLabel" Margin="0,6,0,0" Style="{StaticResource MutedText}"/>
            </StackPanel>
        </Border>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="AddCommandButton" Content="&#xE765;" Click="OnAddCommand" Margin="0,0,8,0"
                        Style="{StaticResource IconButton}"/>
                <Button x:Name="AddClickButton" Content="&#xE962;" Click="OnAddClick"
                        Style="{StaticResource PrimaryIconButton}"/>
            </StackPanel>
            <TextBlock x:Name="ErrorLabel" Margin="0,4,0,0" FontSize="11" Foreground="{StaticResource DangerBrush}"/>
        </StackPanel>
        <ListBox x:Name="ActionList" AllowDrop="True"
                 PreviewMouseLeftButtonDown="OnRowPreviewMouseDown"
                 PreviewMouseMove="OnRowPreviewMouseMove"
                 DragOver="OnRowDragOver"
                 Drop="OnRowDrop">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Click="OnDuplicateRow" Margin="0,0,4,0" ToolTip="{x:Static res:Strings.Duplicate}"
                                    Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12">&#xE8C8;</Button>
                            <Button Click="OnRemoveRow" Margin="0,0,4,0" ToolTip="{x:Static res:Strings.Delete}"
                                    Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12">&#xE74D;</Button>
                            <Button Click="OnMoveRowUp" Margin="0,0,4,0" ToolTip="{x:Static res:Strings.MoveUp}"
                                    Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12">&#xE70E;</Button>
                            <Button Click="OnMoveRowDown" ToolTip="{x:Static res:Strings.MoveDown}"
                                    Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12">&#xE70C;</Button>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                        <ComboBox Width="170" Margin="0,0,8,0"
                                  ItemsSource="{Binding DataContext.MemberAccounts, RelativeSource={RelativeSource AncestorType=Window}}"
                                  DisplayMemberPath="CharacterName"
                                  SelectedItem="{Binding SelectedAccount, Mode=TwoWay}"/>
                        <ComboBox Width="80" Margin="0,0,8,0"
                                  ItemsSource="{Binding DataContext.ActionTypes, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding Type, Mode=TwoWay}"/>
                        <ComboBox x:Name="RowKeyBox" Width="90" Margin="0,0,8,0"
                                  ItemsSource="{Binding DataContext.AvailableKeys, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding Key, Mode=TwoWay}"/>
                        <Button x:Name="RowCaptureButton" Click="OnCaptureRow" Margin="0,0,8,0"
                                Content="{x:Static res:Strings.CaptureClick}"/>
                        <ComboBox x:Name="RowButtonBox" Width="90" Margin="0,0,8,0"
                                  ItemsSource="{Binding DataContext.MouseButtons, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding Button, Mode=TwoWay}"/>
                        <TextBlock x:Name="RowPositionText" Width="130" Margin="0,0,8,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource AccentBrush}"
                                   Text="{Binding PositionLabel}"/>
                        <TextBox Width="70" Margin="0,0,8,0" ToolTip="{x:Static res:Strings.DelayMs}"
                                 Text="{Binding DelayBeforeMs, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"/>
                        </StackPanel>
                    </DockPanel>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.Key}">
                            <Setter TargetName="RowCaptureButton" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="RowPositionText" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.Click}">
                            <Setter TargetName="RowKeyBox" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="{x:Static models:ActionType.Key}">
                            <Setter TargetName="RowButtonBox" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
