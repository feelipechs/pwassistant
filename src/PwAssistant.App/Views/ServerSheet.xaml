<UserControl x:Class="PwAssistant.App.Views.ServerSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="Dimmer" Background="#80000000"
          PreviewMouseLeftButtonDown="OnDimmerDown" PreviewKeyDown="OnSheetKeyDown" Focusable="True">
        <Border Width="380" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="NameLabel" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,0,0,2"/>
                <TextBox x:Name="NameBox"/>
                <TextBlock x:Name="PathLabel" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,8,0,2"/>
                <DockPanel>
                    <Button x:Name="BrowseButton" Content="&#xE838;" DockPanel.Dock="Right" Click="OnBrowse"
                            FontFamily="{StaticResource IconFont}" FontSize="14"
                            Style="{StaticResource IconButton}" Width="36"/>
                    <TextBox x:Name="PathBox"/>
                </DockPanel>
                <TextBlock x:Name="PathHint" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,2,0,0"
                           TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="CancelButton" Click="OnCancel" Style="{StaticResource GhostButton}"/>
                    <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
