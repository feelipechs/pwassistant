<UserControl x:Class="PwAssistant.App.Views.SettingsSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="Dimmer" Background="#80000000"
          PreviewMouseLeftButtonDown="OnDimmerDown" PreviewKeyDown="OnSheetKeyDown" Focusable="True">
        <Border Width="380" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="FocusConfigLabel" Style="{StaticResource SectionTitle}"/>
                <TextBlock x:Name="CycleKeyCaption" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,0,0,2"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <Button x:Name="RecordCycleButton" Click="OnRecordCycle" Style="{StaticResource OutlineButton}" Margin="0,0,8,0" MinWidth="130"/>
                    <Border x:Name="CycleKeyBox" Background="{DynamicResource Brush.Background}"
                            BorderBrush="{DynamicResource Brush.Input}" BorderThickness="1" CornerRadius="6"
                            Padding="10,4" VerticalAlignment="Center" MinWidth="150">
                        <TextBlock x:Name="CycleKeyValueLabel" VerticalAlignment="Center"
                                   Foreground="{DynamicResource Brush.Primary}" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.Md}"/>
                    </Border>
                </StackPanel>
                <CheckBox x:Name="NumpadCheck" Margin="0,8,0,0" Style="{StaticResource ToggleSwitch}"/>
                <CheckBox x:Name="ShiftTapCheck" Margin="0,4,0,0" Style="{StaticResource ToggleSwitch}"/>
                <TextBlock x:Name="ArmingHintLabel" Margin="0,8,0,0" Style="{StaticResource MutedText}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                    <Button x:Name="CloseButton" Click="OnClose" Style="{StaticResource GhostButton}" MinWidth="90"/>
                    <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
