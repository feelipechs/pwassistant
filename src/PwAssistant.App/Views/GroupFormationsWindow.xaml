<Window x:Class="PwAssistant.App.Views.GroupFormationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Formations" Height="360" Width="440" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <DockPanel Margin="16,12,16,12">
        <TextBlock x:Name="FormationsLabel" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Formations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <DockPanel>
                                <Button Content="&#xE73E;"
                                        DockPanel.Dock="Right"
                                        Click="OnLoadFormationClick"
                                        Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           Foreground="{StaticResource TextPrimaryBrush}"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
</Window>
