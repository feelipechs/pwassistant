<Window x:Class="PwAssistant.App.Views.GroupFormationsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PwAssistant.App.Views"
        Title="Formations" Height="360" Width="440" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="{StaticResource Font.Family}"
        Style="{StaticResource ThemedWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <views:TitleBar/>
    <DockPanel Grid.Row="1" Margin="16,12,16,12">
        <TextBlock x:Name="FormationsLabel" DockPanel.Dock="Top" Style="{StaticResource SectionTitle}" Margin="0,0,0,8"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Formations}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6">
                            <DockPanel>
                                <Button Content="&#xE73E;"
                                        DockPanel.Dock="Right"
                                        Click="OnLoadFormationClick"
                                        Style="{StaticResource IconButton}" Width="24" Height="24" FontSize="12"/>
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.Foreground}"/>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
    </Grid>
</Window>
