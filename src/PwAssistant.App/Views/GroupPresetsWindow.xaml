<Window x:Class="PwAssistant.App.Views.GroupPresetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PwAssistant.App.Views"
        Title="Presets" Height="420" Width="560" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="{StaticResource Font.Family}"
        Style="{StaticResource ThemedWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <views:TitleBar/>
    <DockPanel Grid.Row="1" Margin="16,12,16,12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Button x:Name="NewPresetButton" Content="&#xE710;" Command="{Binding AddPresetCommand}"
                    DockPanel.Dock="Right" Style="{StaticResource IconButton}"/>
            <TextBlock x:Name="PresetsLabel" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
        </DockPanel>
        <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource StatusText}"
                   DockPanel.Dock="Bottom" Margin="0,8,0,0"/>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Presets}"
                           PreviewMouseLeftButtonDown="OnPresetPreviewMouseDown"
                           PreviewMouseMove="OnPresetPreviewMouseMove"
                           AllowDrop="True"
                           DragOver="OnPresetDragOver"
                           Drop="OnPresetDrop">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,0,6" Cursor="SizeAll">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <Button Content="&#xE70F;"
                                            Command="{Binding DataContext.EditPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"/>
                                    <Button Content="&#xE8C8;"
                                            Command="{Binding DataContext.DuplicatePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"/>
                                    <Button Content="&#xE74D;"
                                            Command="{Binding DataContext.DeletePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource IconButton}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Brush.Foreground}"/>
                                    <TextBlock Text="{Binding Hotkey}" FontSize="11"
                                               Foreground="{DynamicResource Brush.Primary}"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>
    <!-- Drag ghost host: above content, hit-test invisible. -->
    <Canvas x:Name="GhostLayer" Grid.RowSpan="2" IsHitTestVisible="False"/>
    </Grid>
</Window>
