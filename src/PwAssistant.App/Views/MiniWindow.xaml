<Window x:Class="PwAssistant.App.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PwAssistant.Core.Models;assembly=PwAssistant.Core"
        Title="PW Assistant Mini" Height="340" Width="300"
        Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Border Margin="10" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="10">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="GroupBox" Width="212" Margin="0,0,8,0"
                          ItemsSource="{Binding Groups}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedGroup}"/>
            </StackPanel>
            <StackPanel x:Name="ContentPanel" Margin="0,10,0,0">
                <ListBox x:Name="MiniMembersList" Height="84" ItemsSource="{Binding Members}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Account.Status}" Value="{x:Static models:AccountStatus.Offline}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock x:Name="MemberName" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="MemberName" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="MemberName" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ItemsControl ItemsSource="{Binding MiniRows}" Margin="0,6,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Button Content="{Binding DisplayFireText}" Width="160" Focusable="False"
                                        Style="{StaticResource PrimaryButton}"
                                        Command="{Binding DataContext.FirePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding Preset}"/>
                                <CheckBox Content="{Binding DataContext.LoopText, RelativeSource={RelativeSource AncestorType=Window}}"
                                          IsChecked="{Binding IsLooping, Mode=OneWay}" Focusable="False"
                                          Style="{StaticResource ToggleSwitch}"
                                          Command="{Binding DataContext.ToggleLoopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <CheckBox x:Name="SyncCheck" Margin="0,4,0,0" Focusable="False"
                          Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncEnabled}"/>
                <CheckBox x:Name="FocusCheck" Margin="0,2,0,0" Focusable="False"
                          Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FocusEnabled}"/>
                <TextBlock x:Name="KeysLabel" Margin="0,8,0,0" Style="{StaticResource MutedText}"
                           Text="{Binding FocusKeysLegend}"/>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0" Style="{StaticResource StatusText}" TextWrapping="Wrap"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
