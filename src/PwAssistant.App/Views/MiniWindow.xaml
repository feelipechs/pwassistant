<Window x:Class="PwAssistant.App.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PwAssistant.Core.Models;assembly=PwAssistant.Core"
        Title="PW Assistant Mini" Height="320" Width="300"
        Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <Border Margin="8" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1" CornerRadius="8" Padding="8">
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <ComboBox x:Name="GroupBox" Width="212" Margin="0,0,8,0"
                          ItemsSource="{Binding Groups}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding SelectedGroup}"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <CheckBox x:Name="SyncCheck" Margin="0,0,12,0" Focusable="False"
                          Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncEnabled}"/>
                <CheckBox x:Name="FocusCheck" Margin="0,0,0,0" Focusable="False"
                          Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FocusEnabled}"/>
            </StackPanel>
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
            <StackPanel x:Name="ContentPanel">
                <ListBox x:Name="MiniMembersList" Height="84" ItemsSource="{Binding Members}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Account.Status}" Value="{x:Static models:AccountStatus.Offline}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource MiniCard}" Cursor="Arrow" Padding="5" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="20" Height="20" Margin="0,0,6,0"
                                           Source="{Binding ClassImagePath}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClassImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock x:Name="MemberName" Text="{Binding CharacterName}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="MemberName" Property="FontWeight" Value="Bold"/>
                                    <Setter TargetName="MemberName" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ItemsControl ItemsSource="{Binding MiniRows}" Margin="0,4,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,4,2">
                                <DockPanel VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsLooping, Mode=OneWay}" Focusable="False"
                                              DockPanel.Dock="Right"
                                              Style="{StaticResource ToggleSwitch}" Margin="0"
                                              VerticalAlignment="Center"
                                              Command="{Binding DataContext.ToggleLoopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}"/>
                                    <Button Content="{Binding DisplayFireText}" Focusable="False"
                                            FontSize="11" MinHeight="22" Padding="6,0" Margin="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.FirePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Preset}"/>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding StatusMessage}" Margin="0,6,0,0" Style="{StaticResource StatusText}" TextWrapping="Wrap"/>
            </StackPanel>
            </ScrollViewer>
        </StackPanel>
    </Border>
</Window>
