<Window x:Class="PwAssistant.App.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:PwAssistant.Core.Models;assembly=PwAssistant.Core"
        xmlns:views="clr-namespace:PwAssistant.App.Views"
        Title="PW Assistant Mini" Height="420" Width="300" MinWidth="260" MinHeight="300"
        Topmost="True" WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" AllowsTransparency="True"
        Background="Transparent" Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="{StaticResource Font.Family}"
        Style="{StaticResource ThemedWindow}">
    <Border Margin="8" Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
            BorderThickness="1" CornerRadius="8" Padding="8">
        <Grid>
        <DockPanel>
            <views:TitleBar DockPanel.Dock="Top"/>
            <TextBlock Text="{Binding StatusMessage}" DockPanel.Dock="Bottom" Margin="0,6,0,0" Style="{StaticResource StatusText}" TextWrapping="Wrap"/>
            <TextBlock DockPanel.Dock="Top" HorizontalAlignment="Center" Margin="0,8,0,4"
                       FontSize="{StaticResource Font.Size.Md}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Brush.Foreground}" TextTrimming="CharacterEllipsis"
                       Text="{Binding MiniGroupTitle}"/>
            <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,8">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="SyncCheck" Margin="0" Focusable="False"
                              Style="{StaticResource ToggleSwitch}" IsChecked="{Binding SyncEnabled}"/>
                    <TextBlock x:Name="SyncLabel" Margin="4,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Font.Size.Xs}"
                               Foreground="{DynamicResource Brush.MutedForeground}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="FocusCheck" Margin="0" Focusable="False"
                              Style="{StaticResource ToggleSwitch}" IsChecked="{Binding FocusEnabled}"/>
                    <TextBlock x:Name="FocusLabel" Margin="4,0,0,0" VerticalAlignment="Center"
                               FontSize="{StaticResource Font.Size.Xs}"
                               Foreground="{DynamicResource Brush.MutedForeground}"/>
                </StackPanel>
            </UniformGrid>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="MiniMembersList" Grid.Column="0" MinHeight="120" ItemsSource="{Binding Members}">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Account.Status}" Value="{x:Static models:AccountStatus.Offline}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                                    <Border x:Name="MiniCardBorder" Style="{StaticResource MiniCard}" Cursor="Arrow" Padding="5" Margin="0,0,0,4">
                                <StackPanel Orientation="Horizontal">
                                    <Image Width="16" Height="16" Margin="0,0,6,0"
                                           Source="{Binding ClassImagePath}">
                                        <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding ClassImagePath}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock x:Name="MemberName" Text="{Binding CharacterName}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="MemberName" Property="FontWeight" Value="SemiBold"/>
                                    <Setter TargetName="MemberName" Property="Foreground" Value="{DynamicResource Brush.Primary}"/>
                                    <Setter TargetName="MiniCardBorder" Property="Background" Value="{DynamicResource Brush.RaisedHover}"/>
                                    <Setter TargetName="MiniCardBorder" Property="BorderBrush" Value="{DynamicResource Brush.Ring}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding MiniRows}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource Brush.Raised}" BorderBrush="{DynamicResource Brush.Border}"
                                    BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,4,2">
                                <DockPanel VerticalAlignment="Center">
                                    <CheckBox IsChecked="{Binding IsLooping, Mode=OneWay}" Focusable="False"
                                              DockPanel.Dock="Right"
                                              Style="{StaticResource ToggleSwitch}" Margin="0"
                                              VerticalAlignment="Center"
                                              Command="{Binding DataContext.ToggleLoopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                              CommandParameter="{Binding}"/>
                                    <Button x:Name="FireButton" Content="{Binding DisplayFireText}" Focusable="False"
                                            FontSize="10" MinHeight="18" Padding="4,0" Margin="0"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Style="{StaticResource GhostButton}"
                                            Command="{Binding DataContext.FirePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding Preset}"/>
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsFiring}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard x:Name="LoopBlink">
                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                <ColorAnimation Storyboard.TargetName="FireButton"
                                                                Storyboard.TargetProperty="(Button.Foreground).(SolidColorBrush.Color)"
                                                                From="{StaticResource Color.MutedForeground}"
                                                                To="{StaticResource Color.Primary}"
                                                                Duration="0:0:0.6"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="LoopBlink"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                </ScrollViewer>
            </Grid>
        </DockPanel>
            <TextBlock Text="&#x25E2;" FontSize="11" TextAlignment="Center"
                       HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="20" Height="20"
                       Foreground="{DynamicResource Brush.MutedForeground}" Opacity="0.7"
                       Background="Transparent" Cursor="SizeNWSE" Focusable="False"
                       PreviewMouseLeftButtonDown="OnResizeGripDown"/>
        </Grid>
    </Border>
</Window>
