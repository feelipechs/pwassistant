<Window x:Class="PwAssistant.App.Views.MiniWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PW Assistant Mini" Height="320" Width="280"
        Topmost="True" WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <StackPanel Margin="8">
        <StackPanel Orientation="Horizontal">
            <ComboBox x:Name="GroupBox" Width="170" Margin="0,0,8,0"
                      ItemsSource="{Binding Groups}"
                      DisplayMemberPath="Name"
                      SelectedItem="{Binding SelectedGroup}"/>
            <Button x:Name="CollapseButton" Click="OnCollapse" Width="30"/>
        </StackPanel>
        <StackPanel x:Name="ContentPanel" Margin="0,8,0,0">
            <ListBox x:Name="MiniMembersList" Height="80" ItemsSource="{Binding Members}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock x:Name="MemberName" Text="{Binding DisplayName}" VerticalAlignment="Center"/>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsActive}" Value="True">
                                <Setter TargetName="MemberName" Property="FontWeight" Value="Bold"/>
                                <Setter TargetName="MemberName" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <ItemsControl ItemsSource="{Binding MiniRows}" Margin="0,4,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Button Content="{Binding DisplayFireText}" Width="150" Focusable="False"
                                    Command="{Binding DataContext.FirePresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding Preset}"/>
                            <ToggleButton Content="{Binding DataContext.LoopText, RelativeSource={RelativeSource AncestorType=Window}}"
                                          IsChecked="{Binding IsLooping, Mode=OneWay}" Focusable="False"
                                          Command="{Binding DataContext.ToggleLoopCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                          CommandParameter="{Binding}"/>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <CheckBox x:Name="SyncCheck" Margin="0,4,0,0" Focusable="False" IsChecked="{Binding SyncEnabled}"/>
            <CheckBox x:Name="FocusCheck" Margin="0,4,0,0" Focusable="False" IsChecked="{Binding FocusEnabled}"/>
            <TextBlock x:Name="KeysLabel" Margin="0,8,0,0" TextWrapping="Wrap" FontStyle="Italic" FontSize="11"
                       Text="{Binding FocusKeysLegend}"/>
            <TextBlock Text="{Binding StatusMessage}" Margin="0,4,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </StackPanel>
</Window>
