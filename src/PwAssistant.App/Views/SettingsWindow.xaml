<Window x:Class="PwAssistant.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="330" Width="440" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <StackPanel Margin="16,12,16,12">
        <TextBlock x:Name="FocusConfigLabel" Style="{StaticResource SectionTitle}"/>
        <TextBlock x:Name="CycleKeyCaption" Foreground="{StaticResource TextSecondaryBrush}"/>
        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
            <TextBlock x:Name="CycleKeyValueLabel" Width="150" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="13"/>
            <Button x:Name="RecordCycleButton" Click="OnRecordCycle" Style="{StaticResource GhostButton}"/>
        </StackPanel>
        <CheckBox x:Name="NumpadCheck" Margin="0,10,0,0" Style="{StaticResource ToggleSwitch}"/>
        <CheckBox x:Name="ShiftTapCheck" Margin="0,4,0,0" Style="{StaticResource ToggleSwitch}"/>
        <TextBlock x:Name="ArmingHintLabel" Margin="0,12,0,0" Style="{StaticResource MutedText}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CloseButton" Click="OnClose" Style="{StaticResource GhostButton}" MinWidth="90"/>
            <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
        </StackPanel>
    </StackPanel>
</Window>
