<Window x:Class="PwAssistant.App.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Height="300" Width="420" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <StackPanel Margin="12">
        <TextBlock x:Name="FocusConfigLabel" FontWeight="Bold" Margin="0,0,0,4"/>
        <TextBlock x:Name="CycleKeyCaption" Margin="0,0,0,2"/>
        <ComboBox x:Name="CycleKeyBox" DisplayMemberPath="Label"/>
        <TextBlock x:Name="CycleWarningLabel" Margin="0,4,0,0" TextWrapping="Wrap" FontStyle="Italic" FontSize="11" Foreground="Tomato"/>
        <CheckBox x:Name="NumpadCheck" Margin="0,8,0,0"/>
        <CheckBox x:Name="ShiftTapCheck" Margin="0,4,0,0"/>
        <TextBlock x:Name="ArmingHintLabel" Margin="0,12,0,0" TextWrapping="Wrap" FontStyle="Italic" FontSize="11"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CloseButton" Click="OnClose"/>
        </StackPanel>
    </StackPanel>
</Window>
