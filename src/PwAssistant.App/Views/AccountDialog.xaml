<Window x:Class="PwAssistant.App.Views.AccountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account" Height="400" Width="400" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BackgroundBrush}" Foreground="White">
    <StackPanel Margin="12">
        <TextBlock x:Name="LoginLabel"/>
        <TextBox x:Name="LoginBox"/>
        <TextBlock x:Name="PasswordLabel"/>
        <PasswordBox x:Name="PasswordBox" Margin="4"/>
        <TextBlock x:Name="RoleLabel"/>
        <TextBox x:Name="RoleBox"/>
        <TextBlock x:Name="NicknameLabel"/>
        <TextBox x:Name="NicknameBox"/>
        <CheckBox x:Name="SameAsRoleCheck" Margin="0,4,0,0"/>
        <TextBlock x:Name="ClassLabel"/>
        <ComboBox x:Name="ClassBox" DisplayMemberPath="Display"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="SaveButton" Click="OnSave"/>
        </StackPanel>
    </StackPanel>
</Window>
