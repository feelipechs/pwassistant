<Window x:Class="PwAssistant.App.Views.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PwAssistant.App.Views"
        Title="Confirm" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" ResizeMode="NoResize"
        Style="{StaticResource ThemedWindow}"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="{StaticResource Font.Family}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <views:TitleBar/>
    <StackPanel Grid.Row="1" Margin="16,12,16,12">
        <TextBlock x:Name="MessageLabel" TextWrapping="Wrap" FontSize="{StaticResource Font.Size.Md}"
                   Foreground="{DynamicResource Brush.Foreground}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Click="OnCancel" Style="{StaticResource GhostButton}" MinWidth="110"/>
            <Button x:Name="ConfirmButton" Click="OnConfirm" Style="{StaticResource DestructiveButton}" MinWidth="110"/>
        </StackPanel>
    </StackPanel>
    </Grid>
</Window>
