<UserControl x:Class="PwAssistant.App.Views.ConfirmSheet"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Visibility="Collapsed">
    <Grid x:Name="Dimmer" Background="#80000000"
          PreviewMouseLeftButtonDown="OnDimmerDown" PreviewKeyDown="OnSheetKeyDown" Focusable="True">
        <Border Width="380" MaxWidth="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Brush.Card}" BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="TitleLabel" FontWeight="SemiBold" FontSize="{StaticResource Font.Size.Md}"
                           Foreground="{DynamicResource Brush.Foreground}"/>
                <TextBlock x:Name="MessageLabel" TextWrapping="Wrap" Margin="0,6,0,0"
                           FontSize="{StaticResource Font.Size.Sm}"
                           Foreground="{DynamicResource Brush.MutedForeground}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                    <Button x:Name="CancelButton" Click="OnCancel" Style="{StaticResource GhostButton}" MinWidth="110"/>
                    <Button x:Name="ConfirmButton" Click="OnConfirm" Style="{StaticResource DestructiveButton}" MinWidth="110"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
