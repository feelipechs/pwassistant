<Window x:Class="PwAssistant.App.Views.ServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Server" Height="240" Width="440" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <StackPanel Margin="16,12,16,12">
        <TextBlock x:Name="NameLabel" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox x:Name="NameBox"/>
        <TextBlock x:Name="PathLabel" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,6,0,0"/>
        <DockPanel>
            <Button x:Name="BrowseButton" Content="..." DockPanel.Dock="Right" Click="OnBrowse"
                    Style="{StaticResource IconButton}" Width="36"/>
            <TextBox x:Name="PathBox"/>
        </DockPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="CancelButton" Click="OnCancel" Style="{StaticResource GhostButton}"/>
            <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
        </StackPanel>
    </StackPanel>
</Window>
