<Window x:Class="PwAssistant.App.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:PwAssistant.App.Views"
        Title="..." Width="380" SizeToContent="Height" WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        Background="{DynamicResource Brush.Background}" Foreground="{DynamicResource Brush.Foreground}"
        FontFamily="{StaticResource Font.Family}"
        Style="{StaticResource ThemedWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <views:TitleBar/>
    <StackPanel Grid.Row="1" Margin="16,12,16,12">
        <TextBlock x:Name="PromptLabel" Foreground="{DynamicResource Brush.MutedForeground}" Margin="0,0,0,2"/>
        <TextBox x:Name="ValueBox"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Click="OnCancel" Style="{StaticResource GhostButton}"/>
            <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
        </StackPanel>
    </StackPanel>
    </Grid>
</Window>
