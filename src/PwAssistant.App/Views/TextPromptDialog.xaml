<Window x:Class="PwAssistant.App.Views.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="..." Height="180" Width="380" WindowStartupLocation="CenterOwner"
        Background="{StaticResource BgBrush}" Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="{StaticResource AppFont}">
    <StackPanel Margin="16,12,16,12">
        <TextBlock x:Name="PromptLabel" Foreground="{StaticResource TextSecondaryBrush}"/>
        <TextBox x:Name="ValueBox" Margin="0,4,0,0"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Click="OnSave" Style="{StaticResource PrimaryButton}" MinWidth="110"/>
        </StackPanel>
    </StackPanel>
</Window>
