<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- shadcn neutral (dark). Single source for every Brush.* (see Brushes.xaml).
         Contrasts verified in ui-theme-and-layout-plan.md §4.2 / §8. -->
    <Color x:Key="Color.Background">#0A0A0A</Color>
    <Color x:Key="Color.Card">#171717</Color>
    <Color x:Key="Color.Raised">#262626</Color>
    <Color x:Key="Color.RaisedHover">#303030</Color>
    <Color x:Key="Color.Foreground">#FAFAFA</Color>
    <Color x:Key="Color.Primary">#FAFAFA</Color>
    <Color x:Key="Color.PrimaryHover">#E5E5E5</Color>
    <Color x:Key="Color.PrimaryForeground">#171717</Color>
    <Color x:Key="Color.MutedForeground">#A3A3A3</Color>
    <Color x:Key="Color.Input">#737373</Color>
    <Color x:Key="Color.Border">#262626</Color>
    <Color x:Key="Color.Ring">#D4D4D4</Color>
    <Color x:Key="Color.Destructive">#F87171</Color>
    <Color x:Key="Color.DestructiveSolid">#C62828</Color>
    <Color x:Key="Color.OnDestructiveSolid">#FFFFFF</Color>
    <Color x:Key="Color.Success">#4ADE80</Color>
    <Color x:Key="Color.Warning">#FBBF24</Color>
</ResourceDictionary>
