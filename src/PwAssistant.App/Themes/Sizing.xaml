<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!-- Spacing scale (StaticResource: metrics never swap at runtime). -->
    <sys:Double x:Key="Space.XS">4</sys:Double>
    <sys:Double x:Key="Space.S">8</sys:Double>
    <sys:Double x:Key="Space.M">12</sys:Double>
    <sys:Double x:Key="Space.L">16</sys:Double>
    <sys:Double x:Key="Space.XL">24</sys:Double>
    <sys:Double x:Key="Space.XXL">32</sys:Double>

    <!-- Ready-made insets -->
    <Thickness x:Key="Inset.Page">16</Thickness>
    <Thickness x:Key="Inset.Card">16</Thickness>
    <Thickness x:Key="Inset.Row">12,8</Thickness>
    <Thickness x:Key="Inset.Control">12,0</Thickness>

    <!-- Control metrics (20: compact density chosen by the author over the
         32–36 touch-target guideline — documented exception in ui-audit). -->
    <sys:Double x:Key="Size.Control">20</sys:Double>
    <sys:Double x:Key="Size.Icon.S">16</sys:Double>
    <sys:Double x:Key="Size.Icon.M">20</sys:Double>
    <sys:Double x:Key="Size.Icon.L">24</sys:Double>

    <!-- Radii -->
    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Md">6</CornerRadius>
</ResourceDictionary>
