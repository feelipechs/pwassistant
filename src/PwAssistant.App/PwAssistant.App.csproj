<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Allows this Windows-only UI project to compile on Linux dev machines.
         It still only RUNS on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>PwAssistant.App</RootNamespace>
    <ApplicationIcon>Resources\App.ico</ApplicationIcon>
    <!-- Custom Main (Velopack hooks before any WPF overhead): App.xaml is
         a plain Page, startup runs through Main below. -->
    <StartupObject>PwAssistant.App.App</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Velopack" Version="1.0.1" />
  </ItemGroup>

  <!-- WinForms is referenced for NotifyIcon only: drop its implicit
       usings so WPF types (Point, Application, DragEventArgs…) stay
       unambiguous project-wide. TrayManager qualifies explicitly. -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\Classes\*.png" />
    <Resource Include="Resources\AppIcon.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Resources\Classes\*.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PwAssistant.Core\PwAssistant.Core.csproj" />
    <ProjectReference Include="..\PwAssistant.WinApi\PwAssistant.WinApi.csproj" />
    <!-- Build order only (no assembly reference): the worker exe is spawned,
         never linked. The AfterBuild copy below stages it next to the app. -->
    <ProjectReference Include="..\PwAssistant.Sender\PwAssistant.Sender.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Dev loop: the sender needs its exe AND its managed dll next to the
       app (a framework apphost without its dll dies with a host error —
       seen live as exit 0x8000809A). The build tree lives outside the repo
       (Directory.Build.props), hence the TEMP path. Skipped when the sender
       wasn't built in this pass (e.g. App publish: the release flow
       publishes the sender explicitly — doc/release.md). -->
  <Target Name="CopySenderWorker" AfterTargets="AfterBuild" Condition="'$(DesignTimeBuild)' != 'true'">
    <Copy SourceFiles="$(TEMP)/pwassistant-build/bin/PwAssistant.Sender/$(Configuration)/net8.0/PwAssistant.Sender.exe;$(TEMP)/pwassistant-build/bin/PwAssistant.Sender/$(Configuration)/net8.0/PwAssistant.Sender.dll" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" Condition="Exists('$(TEMP)/pwassistant-build/bin/PwAssistant.Sender/$(Configuration)/net8.0/PwAssistant.Sender.exe')" />
  </Target>

</Project>
